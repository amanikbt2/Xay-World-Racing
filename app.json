{
  "expo": {
    "name": "Xayrush Racing",
    "slug": "xayrush-racing",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#121826"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amanikbt1.xayworldracing"
    },
    "android": {
      "package": "com.amanikbt1.xayworldracing",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#121826"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "143a8780-516c-4607-8d26-dc1012da39c0"
      }
    },
    "owner": "sliver2",
    "plugins": [
      "expo-audio",
      "expo-asset"
    ]
  }
}
